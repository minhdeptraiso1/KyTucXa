# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên git

# ============================================================
# Database
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/appdb
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=7d

# ============================================================
# Cache TTL (optional – có default trong application.yaml)
# ============================================================
CACHE_DEFAULT_TTL=10m
CACHE_TTL_USER_DETAIL=10m
CACHE_TTL_USER_CURRENT=5m
CACHE_TTL_USER_SEARCH=2m

# ============================================================
# API context path
# ============================================================
CONTEXT_PATH=/api/v1

# ============================================================
# SMTP email (Gmail dùng App Password, không dùng mật khẩu chính)
# ============================================================
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=KTX UET <your_gmail@gmail.com>
APP_FRONTEND_URL=http://localhost:5173

# ============================================================
# Gemini (dự phòng cho trợ lý/automation ở phase sau)
# ============================================================
GEMINI_PROJECT_ID=your_google_cloud_project_id
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# VNPay sandbox (được sử dụng từ Phase 5)
# ============================================================
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECRET_KEY=your_vnpay_secret_key
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_ORDER_TYPE=other
